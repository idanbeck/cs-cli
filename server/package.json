{
  "name": "csterm-server",
  "version": "1.0.0",
  "description": "Multiplayer game server for CSterm - Counter-Strike in your terminal",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "csterm-server": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:hub": "node dist/index.js --hub-only",
    "start:pool": "node dist/index.js --pool",
    "dev": "tsc --watch & node --watch dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "game",
    "server",
    "multiplayer",
    "websocket",
    "fps",
    "counter-strike",
    "terminal",
    "csterm"
  ],
  "author": "idanbeck",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "ws": "^8.14.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.2"
  }
}
